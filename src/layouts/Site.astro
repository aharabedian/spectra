---
// Layout for the hand-written pages (home and the three project landing pages).
// The docs use Starlight, dressed the same way through src/components/starlight/.
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/tokens.css';
import '../styles/site.css';
import SiteNav from '../components/SiteNav.astro';
import SubNav from '../components/SubNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { u } from '../lib/site';

interface Props {
  title: string;
  description: string;
  active: 'home' | 'prism' | 'lens' | 'lumen';
}
const { title, description, active } = Astro.props;
const current = active === 'home' ? 'suite' : active;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={u('favicon.ico')} sizes="48x48" />
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={u('apple-touch-icon.png')} />
  <meta name="theme-color" content="#0B0E11" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(u('social/spectra-og-1200x630.png'), Astro.site)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
</head>
<body class="site" data-project={active}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="site-header-in"><SiteNav current={current} section="overview" /></div>
  </header>
  <div class="site-subnav"><div class="site-subnav-in"><SubNav current={current} section="overview" /></div></div>
  <div id="main"><slot /></div>
  <SiteFooter />
</body>
</html>
