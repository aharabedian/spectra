---
// Layout for the hand-written pages (home and the three project landing pages).
// The docs use Starlight, dressed the same way through src/components/starlight/.
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/tokens.css';
import '../styles/site.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { u } from '../lib/site';

interface Props {
  title: string;
  description: string;
  active: 'home' | 'prism' | 'lens' | 'lumen';
}
const { title, description, active } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  <meta name="theme-color" content="#0B0E11" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
</head>
<body class="site" data-project={active}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="site-header-in"><SiteNav active={active === 'home' ? undefined : active} /></div>
  </header>
  <div id="main"><slot /></div>
  <SiteFooter />
</body>
</html>
