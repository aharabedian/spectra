---
// Starlight's header, replaced by the site's two bars: the top bar (with Starlight's search in it) and
// the project's sections, Docs current. The top bar's links stay in the docs (route-middleware.ts).
import Search from '@astrojs/starlight/components/Search.astro';
import SiteNav from '../SiteNav.astro';
import SubNav from '../SubNav.astro';
import { projectOfDoc, type Area } from '../../lib/site';
const current = (projectOfDoc(Astro.locals.starlightRoute.id)?.id ?? 'suite') as Area;
---
<div class="sl-bars">
  <div class="sl-bar-top">
    <SiteNav current={current} section="docs" docsHrefs={Astro.locals.spectraDocsHrefs}>
      <div class="snav-search"><Search /></div>
    </SiteNav>
  </div>
  <div class="sl-bar-sub"><SubNav current={current} section="docs" /></div>
</div>
