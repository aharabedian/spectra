---
// The page title, under a line that says whose docs these are and which release they describe.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { projectOfDoc, version, type ProjectId } from '../../lib/site';
const route = Astro.locals.starlightRoute;
const p = projectOfDoc(route.id);
---
{p && route.entry.data.template !== 'splash' && (
  <p class="doc-crumb"><span class="navdot" style={`background: ${p.accent}`}></span>{p.name} docs · v{version(p.id as ProjectId)}</p>
)}
<Default />
<style>
  .doc-crumb {
    display: flex; align-items: center; gap: 8px; margin: 0 0 0.75rem; font-family: var(--sp-mono); font-size: 13px;
    color: var(--sp-muted);
  }
</style>
