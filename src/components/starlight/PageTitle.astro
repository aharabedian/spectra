---
// The page title, under a crumb back to the start of the docs it belongs to.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { projectOfDoc, u } from '../../lib/site';
const route = Astro.locals.starlightRoute;
const p = projectOfDoc(route.id);
const crumb = route.entry.data.template !== 'splash';
---
{crumb && <a class="doc-crumb" href={p ? u(`${p.id}/docs/`) : u('guide/')}>{p ? `${p.name} docs` : 'SPECTRA docs'}</a>}
<Default />
<style>
  .doc-crumb {
    display: inline-block; margin-bottom: 0.75rem; font-family: var(--sp-mono); font-size: 13px;
    color: var(--sp-muted); text-decoration: none;
  }
  .doc-crumb:hover { color: var(--sp-text); }
</style>
