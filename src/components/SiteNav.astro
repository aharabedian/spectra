---
// The site's top bar: the Spectra mark, the three projects, the suite guide and GitHub.
// Used by the landing pages and, through Header.astro, by every docs page.
import { u, projects } from '../lib/site';
interface Props { active?: 'home' | 'prism' | 'lens' | 'lumen' | 'guide'; }
const { active } = Astro.props;
---
<div class="snav">
  <a class="snav-brand" href={u()} aria-label="Spectra home">
    <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><path d="M1 15.5 H9" stroke="#E6EAEE" stroke-width="1.8" stroke-linecap="round"/><path d="M13 5 L21 23 H5 Z" fill="none" stroke="#E6EAEE" stroke-width="1.8" stroke-linejoin="round"/><path d="M16.5 12.5 L29 8" stroke="#FF9F43" stroke-width="1.8" stroke-linecap="round"/><path d="M17.2 15 L29 15" stroke="#5EB4FF" stroke-width="1.8" stroke-linecap="round"/><path d="M17.8 17.5 L29 22" stroke="#4FD17A" stroke-width="1.8" stroke-linecap="round"/></svg>
    <span class="snav-word">SPECTRA</span>
  </a>
  <slot />
  <nav class="snav-links" aria-label="Main">
    {projects.map((p) => (
      <a class="navlink" href={u(`${p.id}/`)} aria-current={active === p.id ? 'page' : undefined}>
        <span class="navdot" style={`background: ${p.accent}`}></span>{p.name}
      </a>
    ))}
    <a class="navlink" href={u('guide/')} aria-current={active === 'guide' ? 'page' : undefined}>Docs</a>
    <a class="navlink" href="https://github.com/aharabedian" aria-label="aharabedian on GitHub">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/></svg>
      <span class="snav-gh">GitHub</span>
    </a>
  </nav>
</div>
